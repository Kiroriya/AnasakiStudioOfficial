# Anasaki Studio — settings for docker-compose.yml
# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in:
#   cp .env.example .env
# Docker Compose reads .env automatically. Never commit .env (it is in .gitignore).
# Generate random values with:  openssl rand -hex 32

# ---------------------------------------------------------------- required
# "docker compose up" refuses to start while any of these is empty (there are no
# built-in default passwords). Use letters and digits only (e.g. openssl rand -hex 16):
# the database password is also part of the connection string.

# Key that signs admin logins. Changing it later signs everyone out.
JWT_SECRET=

# Database password for the "anasaki" user. Set it BEFORE the first start;
# changing it afterwards does not change the existing database password.
MYSQL_PASSWORD=

# MySQL root password (only used inside the database container; also read only on the first start).
MYSQL_ROOT_PASSWORD=

# Password of the "anasaki_code" MySQL user: Site Code's own database (developer tables), which has
# no access to the CMS tables. Created on the first start by docker/mysql-init/10-site-code.sh.
# Existing sites (database created before): run the SQL shown in Site code → Database first.
CODE_DB_PASSWORD=

# ---------------------------------------------------------------- optional

# Key that encrypts Site Code secrets (Site code -> Settings). Any long random string
# (openssl rand -hex 32). Empty = a key file site-code.key is created in the plugins volume
# (PLUGINS_DIR); keep it: losing the key makes stored secrets unreadable.
SITE_CODE_SECRET_KEY=

# Name of this installation. Containers and data volumes are named after it.
# Running a second site on the same server (e.g. a demo)? Put it in another folder and give it
# a different name AND port, e.g. COMPOSE_PROJECT_NAME=anasaki-demo and PORT=8091 — otherwise
# "docker compose up" there replaces the first site's containers and shares its database.
# Never change it on an existing site: its data lives in volumes named after it.
COMPOSE_PROJECT_NAME=anasaki-studio

# Port on this machine for the website + admin (http://localhost:8090).
PORT=8090

# Developers only (docker-compose.build.yml): MySQL port opened on 127.0.0.1 for database tools.
# MYSQL_PORT=3306

# Image to run. Pin a version for production, e.g. chichat/anasaki-studio:1.0.0
STUDIO_IMAGE=chichat/anasaki-studio:latest

# Forgot the custom admin URL set in Settings → Security? Put the path here
# (e.g. admin) and restart: it overrides the saved setting. Leave empty normally.
ADMIN_PATH=

# Public address of the site (scheme + host, no trailing slash), e.g. https://example.com.
# Links in emails (password reset, welcome) are built from it; without it they follow the
# request's Host header, which a visitor can forge. Set it on every real site.
SITE_URL=

# Behind a reverse proxy (Caddy, Nginx, Cloudflare tunnel…) set this to true so login limits and
# statistics see the visitor's IP (X-Real-IP, or the last X-Forwarded-For hop) instead of the
# proxy's. Leave it false when port 8090 is reachable directly: the headers could be forged.
TRUST_PROXY=false

# Skip the first-run setup screen by creating the administrator automatically
# (both must be set; only used while the database has no users yet — also adds the example content).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- public demo site (optional)

# Turn this installation into a playground anyone can try:
#  - the login page shows a shared visitor account (below) with a "sign in" button;
#  - visitors can edit content, pages, designs, menus, categories and the theme, and upload small
#    images — but not users, settings, plugins, raw HTML, their own e-mail or password;
#  - every DEMO_RESET_MINUTES everything goes back to the baseline (the content when demo mode was
#    first switched on; an administrator can save a new baseline from the banner in the admin).
# Keep your own administrator account private. Never enable this on a real site.
DEMO_MODE=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
DEMO_RESET_MINUTES=60
